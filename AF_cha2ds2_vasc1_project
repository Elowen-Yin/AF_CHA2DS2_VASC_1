#Medication
add_baseline_med <- function(trial_data,
                             med_data,
                             date_col,
                             new_var,
                             window_days = 365){
  td <- copy(trial_data)
  med <- copy(med_data)
  setDT(td)
  setDT(med)
  td[, trial_id := .I]
  td[, trial_start_date := as.Date(trial_start_date)]
  med[, med_date := as.Date(get(date_col))]
  trial_window <- td[, .(
    trial_id,
    patid,
    window_start = trial_start_date - window_days,
    window_end   = trial_start_date - 1
  )]
  med_flag <- med[
    trial_window,
    on = .(
      patid,
      med_date >= window_start,
      med_date <= window_end
    ),
    nomatch = 0,
    allow.cartesian = TRUE
  ][,.(flag = 1L),by = trial_id]
  td[, (new_var) := 0L]
  td[
    med_flag,
    on = "trial_id",
    (new_var) := i.flag]
  td[, trial_id := NULL]
  return(td)
}

