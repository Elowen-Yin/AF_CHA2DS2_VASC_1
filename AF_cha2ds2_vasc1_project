# 2. Function: match within one trial
match_one_trial <- function(dt, ratio = 2) {
  dt <- copy(dt)
  thib_trial <- unique(dt$trial_num)
  n_treat <- sum(dt$assigned_treat == 1, na.rm = TRUE)
  n_control <- sum(dt$assigned_treat == 0, na.rm = TRUE)
  if (n_treat == 0 | n_control == 0) {
    return(list(
      matched = NULL,
      log = data.table(
        trial_num = thib_trial,
        n_treat = n_treat,
        n_control = n_control,
        matched_n = 0,
        status = "Skipped: no treated or no control")))}
  actual_ratio <- min(ratio, floor(n_control / n_treat))
  if (actual_ratio < 1) {
    return(list(
      matched = NULL,
      log = data.table(
        trial_num = thib_trial,
        n_treat = n_treat,
        n_control = n_control,
        matched_n = 0,
        status = "Skipped: insufficient controls")))}
  use_vars <- match_vars[
    sapply(match_vars, function(v) {
      length(unique(dt[[v]][!is.na(dt[[v]])])) > 1})]
  if (length(use_vars) == 0) {
    return(list(
      matched = NULL,
      log = data.table(
        trial_num = thib_trial,
        n_treat = n_treat,
        n_control = n_control,
        matched_n = 0,
        status = "Skipped: no usable covariates")))}
  
  fml <- as.formula(
    paste("assigned_treat ~", paste(use_vars, collapse = " + ")))
  m <- tryCatch(
    matchit(
      formula = fml,
      data = dt,
      method = "nearest",
      ratio = actual_ratio,
      replace = FALSE,
      distance = "glm",
      caliper = 0.2
    ),
    error = function(e) e)
  if (inherits(m, "error")) {
    return(list(
      matched = NULL,
      log = data.table(
        trial_num = thib_trial,
        n_treat = n_treat,
        n_control = n_control,
        matched_n = 0,
        status = paste0("Error: ", m$message))))}
  matched <- as.data.table(match.data(m))
  matched[, trial_num := thib_trial]
  matched[, actual_ratio := actual_ratio]
  return(list(
    matched = matched,
    log = data.table(
      trial_num = thib_trial,
      n_treat = n_treat,
      n_control = n_control,
      matched_n = nrow(matched),
      status = paste0("Matched: 1:", actual_ratio))))}

